# ==============================================================================
# Hutty Server / API Engine — Environment Variables (.env.example)
# ==============================================================================
#
# Server Port
PORT=4000

# Environment Mode: development | test | production
NODE_ENV=development

# JWT Secret for authentication tokens (Replace with a cryptographically secure random string in production)
JWT_SECRET=your-secure-random-jwt-secret-key-here

# JWT Expiration
JWT_EXPIRES_IN=7d

# PostgreSQL Database Connection String
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cost_calculator_db

# CORS Allowed Origin (Client URL)
CORS_ORIGIN=http://localhost:3000

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Razorpay Online Payment Gateway (Phase 1 Consultation Launch)
# Use test keys in staging/development: rzp_test_...
# Use live keys in production: rzp_live_...
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_razorpay_webhook_secret

# Cashfree Payment Gateway (Phase 1 Sandbox / Test Environment)
# Do not switch to live payments. Use sandbox test credentials.
# Test endpoint: https://sandbox.cashfree.com/pg
CASHFREE_APP_ID=your_cashfree_test_app_id
CASHFREE_SECRET_KEY=your_cashfree_test_secret_key
CASHFREE_WEBHOOK_SECRET=your_cashfree_test_webhook_secret
CASHFREE_ENV=TEST
CASHFREE_API_VERSION=2023-08-01

# Dedicated temporary secret for one-time production database initialization (POST /api/v1/admin/db-init)
# Set in Render environment variables for one-time initialization, then remove after completion.
DB_INIT_SECRET=temporary-secure-random-db-init-secret

# MSG91 Official SMS OTP Provider (SendOTP, Verify OTP, Resend OTP)
# Get from MSG91 Dashboard: https://control.msg91.com
# Keep credentials strictly in server environment variables (never in frontend code or bundles)
MSG91_AUTH_KEY=your_msg91_auth_key_here
MSG91_TEMPLATE_ID=your_dlt_approved_otp_template_id_here
MSG91_OTP_EXPIRY_MINUTES=5
MSG91_OTP_LENGTH=6
