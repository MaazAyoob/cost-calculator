# ==============================================================================
# Hutty Server / API Engine — Environment Variables (.env.example)
# ==============================================================================
#
# Server Port
PORT=4000

# Environment Mode: development | test | production
NODE_ENV=development

# JWT Secret for authentication tokens (Replace with a cryptographically secure random string in production)
JWT_SECRET=your-secure-random-jwt-secret-key-here

# JWT Expiration
JWT_EXPIRES_IN=7d

# PostgreSQL Database Connection String
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cost_calculator_db

# CORS Allowed Origin (Client URL)
CORS_ORIGIN=http://localhost:3000

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Razorpay Online Payment Gateway (Phase 1 Consultation Launch)
# Use test keys in staging/development: rzp_test_...
# Use live keys in production: rzp_live_...
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_razorpay_webhook_secret

