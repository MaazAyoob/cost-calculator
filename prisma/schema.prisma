// ============================================================
// COST CALCULATOR – PRISMA DATABASE SCHEMA (RC1)
// PostgreSQL models with database performance indexes (@index)
// ============================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
  SUPERADMIN
}

enum QualityTier {
  Essential
  Premium
  Luxury
}

enum ProjectStatus {
  DRAFT
  PLANNED
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  phone     String?
  name      String
  role      Role      @default(USER)
  password  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  projects      Project[]
  auditLogs     AuditLog[]
  adminSessions AdminSession[]
  consultationRequests ConsultationRequest[]
  pricingPurchases     PricingPurchase[]
  entitlements         UserEntitlement[]

  @@index([email])
}

model Project {
  id              String                @id @default(uuid())
  name            String
  ownerId         String
  owner           User                  @relation(fields: [ownerId], references: [id])
  city            String
  authority       String
  status          ProjectStatus         @default(PLANNED)
  configuration   ProjectConfiguration?
  calculation     CalculationResult?
  boqItems        BOQItem[]
  paymentSchedule PaymentSchedule[]
  procurementList ProcurementList[]
  consultationRequests ConsultationRequest[]
  pricingPurchases     PricingPurchase[]
  entitlements         UserEntitlement[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([ownerId])
  @@index([city])
  @@index([status])
}

model ProjectConfiguration {
  id             String      @id @default(uuid())
  projectId      String      @unique
  project        Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  plotLength     Float
  plotWidth      Float
  houseType      String
  floors         Int
  parkingType    String
  carCount       Int
  bikeCount      Int
  evCharging     Boolean
  liftRequired   Boolean
  roomsJson      Json
  qualityTier    QualityTier
  materialBrands Json

  @@index([projectId])
}

model CalculationResult {
  id              String   @id @default(uuid())
  projectId       String   @unique
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  totalBUASqFt    Float
  totalCostINR    Float
  costPerSqFt     Float
  steelTonnes     Float
  cementBags      Int
  concreteCuM     Float
  timelineMonths  Int
  budgetBreakdown Json
  quantitiesJson  Json
  configSnapshot  Json?
  calculatedAt    DateTime @default(now())

  @@index([projectId])
}

model BOQItem {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  code        String
  category    String
  description String
  unit        String
  quantity    Float
  unitRate    Float
  amount      Float
  brand       String
  remarks     String?

  @@index([projectId])
  @@index([category])
}

model PaymentSchedule {
  id               String   @id @default(uuid())
  projectId        String
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stage            Int
  title            String
  description      String
  percentage       Float
  amount           Float
  targetDate       String
  status           String
  bankDisbursement Boolean  @default(false)

  @@index([projectId])
}

model ProcurementList {
  id            String   @id @default(uuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  trade         String
  item          String
  brand         String
  specification String
  quantity      Float
  unit          String
  unitRate      Float
  totalCost     Float
  supplierNote  String?
  leadTimeDays  Int      @default(3)

  @@index([projectId])
}

model Brand {
  id           String            @id @default(uuid())
  name         String            @unique
  logoUrl      String?
  description  String?
  website      String?
  active       Boolean           @default(true)
  displayOrder Int               @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  products     MaterialProduct[]

  @@index([active])
  @@index([displayOrder])
  @@map("catalog_brands")
}

model MaterialCategory {
  id       String            @id @default(uuid())
  name     String            @unique
  unit     String
  brands   MaterialBrand[]
  products MaterialProduct[]
}

model MaterialBrand {
  id         String           @id @default(uuid())
  categoryId String
  category   MaterialCategory @relation(fields: [categoryId], references: [id])
  name       String
  tier       QualityTier
  unitRate   Float
  warranty   String?
  isActive   Boolean          @default(true)

  @@index([categoryId])
}

model MaterialProduct {
  id            String            @id @default(uuid())
  brandId       String?
  brandRel      Brand?            @relation(fields: [brandId], references: [id], onDelete: SetNull)
  categoryId    String?
  categoryRel   MaterialCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  category      String            @default("general")
  name          String
  brand         String            @default("")
  imageUrl      String?
  description   String?
  specification String?
  unit          String
  rate          Float             @default(0)
  rateUnit      String?
  rateId        String?
  productCode   String?
  active        Boolean           @default(true)
  displayOrder  Int               @default(0)
  metadataJson  Json?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([brandId])
  @@index([categoryId])
  @@index([category])
  @@index([active])
  @@index([rateId])
  @@map("catalog_products")
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  details   Json?
  timestamp DateTime @default(now())

  @@index([userId])
  @@index([timestamp])
}

model RateOverride {
  id          String   @id @default(uuid())
  rateId      String
  rate        Float
  category    String
  unit        String
  location    String   @default("ALL") // 'Bangalore' | 'Mysore' | 'ALL'
  packageTier String   @default("ALL") // 'STANDARD' | 'PREMIUM' | 'LUXURY' | 'ALL'
  isActive    Boolean  @default(true)
  reason      String?
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([rateId, packageTier, location], name: "rate_dimension_unique")
  @@index([rateId])
  @@index([category])
  @@index([isActive])
  @@map("rate_overrides")
}

model RateAuditLog {
  id          String   @id @default(uuid())
  rateId      String
  rateName    String
  category    String
  unit        String
  oldValue    Float?
  newValue    Float
  action      String   // 'CREATE_OVERRIDE' | 'UPDATE_OVERRIDE' | 'REMOVE_OVERRIDE' | 'RESET_DEFAULT'
  location    String   @default("ALL")
  packageTier String   @default("ALL")
  adminEmail  String
  reason      String?
  timestamp   DateTime @default(now())

  @@index([rateId])
  @@index([adminEmail])
  @@index([timestamp])
  @@map("rate_audit_logs")
}

model CalculatorConfig {
  id        String   @id @default("global-calculator-config")
  key       String   @unique
  valueJson Json
  updatedBy String
  updatedAt DateTime @updatedAt

  @@map("calculator_configs")
}

model CalculationConfigVersion {
  id               String                       @id @default(uuid())
  versionNumber    String                       @unique
  status           String                       @default("DRAFT") // 'DRAFT' | 'VALIDATED' | 'REVIEW' | 'PUBLISHED' | 'ACTIVE' | 'ARCHIVED' | 'REJECTED'
  description      String?
  changeNote       String?
  effectiveFrom    DateTime                     @default(now())
  effectiveTo      DateTime?
  validationStatus String                       @default("VALID")
  parametersCount  Int                          @default(0)
  createdBy        String
  validatedBy      String?
  validatedAt      DateTime?
  publishedBy      String?
  publishedAt      DateTime?
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt
  parameters       CalculationConfigParameter[]
  auditLogs        CalculationConfigAuditLog[]

  @@index([status])
  @@index([versionNumber])
  @@index([effectiveFrom])
  @@map("calculation_config_versions")
}

model CalculationConfigParameter {
  id                String                   @id @default(uuid())
  versionId         String
  version           CalculationConfigVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  key               String
  name              String
  description       String?
  category          String
  valueJson         Json
  unit              String
  valueType         String                   @default("number")
  minimum           Float?
  maximum           Float?
  location          String                   @default("Global")
  specificationTier String                   @default("Global")
  source            String?
  sourceDate        String?
  sourceReference   String?
  isStatutory       Boolean                  @default(false)
  status            String                   @default("ACTIVE")
  createdBy         String
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  @@unique([versionId, key, location, specificationTier], name: "config_param_unique")
  @@index([key])
  @@index([category])
  @@index([location])
  @@index([specificationTier])
  @@index([versionId])
  @@map("calculation_config_parameters")
}

model CalculationConfigAuditLog {
  id           String                   @id @default(uuid())
  versionId    String
  version      CalculationConfigVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  parameterId  String?
  parameterKey String?
  action       String // 'CREATE_DRAFT' | 'EDIT_PARAMETER' | 'VALIDATE' | 'SIMULATE' | 'SUBMIT_REVIEW' | 'APPROVE_REVIEW' | 'PUBLISH' | 'ACTIVATE' | 'ARCHIVE' | 'REJECT' | 'ROLLBACK_PREPARE'
  oldValue     Json?
  newValue     Json?
  reason       String?
  adminEmail   String
  ipAddress    String?
  userAgent    String?
  timestamp    DateTime                 @default(now())

  @@index([versionId])
  @@index([action])
  @@index([adminEmail])
  @@index([timestamp])
  @@map("calculation_config_audit_logs")
}

model AnalyticsEvent {
  id              String   @id @default(uuid())
  eventName       String
  sessionId       String
  step            Int?
  stepName        String?
  timeSpentMs     Int?
  selectedPackage String?
  plotLength      Float?
  plotWidth       Float?
  builtUpArea     Float?
  estimatedCost   Float?
  costPerSqFt     Float?
  metadataJson    Json?
  createdAt       DateTime @default(now())

  @@index([eventName])
  @@index([sessionId])
  @@index([createdAt])
  @@map("analytics_events")
}

enum ProposalStatus {
  PENDING
  APPROVED
  REJECTED
  NEEDS_REVIEW
  UNVERIFIED
  FAILED
}

model PriceUpdateRun {
  id            String                @id @default(uuid())
  provider      String
  status        String                @default("COMPLETED")
  totalProposed Int                   @default(0)
  totalApproved Int                   @default(0)
  totalRejected Int                   @default(0)
  scope         String                @default("ALL")
  category      String?
  runBy         String
  notes         String?
  proposals     PriceUpdateProposal[]
  createdAt     DateTime              @default(now())
  completedAt   DateTime?

  @@index([provider])
  @@index([createdAt])
  @@map("price_update_runs")
}

model PriceUpdateProposal {
  id                String         @id @default(uuid())
  runId             String
  run               PriceUpdateRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  rateId            String
  rateName          String
  category          String
  unit              String
  currentRate       Float
  proposedRate      Float
  difference        Float
  differencePercent Float
  currency          String         @default("INR")
  location          String         @default("ALL")
  packageTier       String         @default("ALL")
  source            String
  sourceUrl         String?
  confidence        String         @default("MEDIUM")
  status            ProposalStatus @default(PENDING)
  notes             String?
  warning           String?
  isAiAssisted      Boolean        @default(false)
  reviewedBy        String?
  reviewedAt        DateTime?
  createdAt         DateTime       @default(now())

  @@index([runId])
  @@index([rateId])
  @@index([status])
  @@index([category])
  @@map("price_update_proposals")
}

model AdminSession {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String
  deviceInfo   String?
  ipAddress    String?
  userAgent    String?
  isActive     Boolean   @default(true)
  lastActiveAt DateTime  @default(now())
  expiresAt    DateTime
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@index([isActive])
  @@map("admin_sessions")
}

model SecurityAuditEvent {
  id        String   @id @default(uuid())
  userId    String?
  userEmail String
  action    String   // 'PASSWORD_CHANGED' | 'EMAIL_CHANGED' | 'LOGIN_SUCCESS' | 'LOGIN_FAILED' | 'LOGOUT' | 'SESSIONS_REVOKED'
  details   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userEmail])
  @@index([action])
  @@index([createdAt])
  @@map("security_audit_events")
}

// ═════════════════════════════════════════════════════════════════════════
// CONSULTATION PLATFORM MODELS (Phase 1 MVP)
// ═════════════════════════════════════════════════════════════════════════

enum ConsultationStatus {
  AWAITING_REVIEW
  UNDER_REVIEW
  ASSIGNED
  ACCEPTED
  SCHEDULED
  RESCHEDULE_REQUESTED
  COMPLETED
  REJECTED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUND_PENDING
  REFUNDED
}

model Consultant {
  id              String                 @id @default(uuid())
  slug            String                 @unique
  name            String
  title           String
  category        String                 // "Architect" | "Structural Engineer" | "Contractor" | "Interior Designer" | "Approvals Consultant" | "Quantity Surveyor" | "Site Supervisor"
  profileImage    String?
  experienceYears Int                    @default(5)
  city            String                 @default("Bangalore")
  serviceAreas    String[]
  about           String
  specializations String[]
  services        String[]
  active          Boolean                @default(true)
  featured        Boolean                @default(false)
  displayOrder    Int                    @default(0)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  requests        ConsultationRequest[]

  @@index([category])
  @@index([city])
  @@index([active])
  @@index([slug])
  @@map("consultants")
}

model ConsultationRequest {
  id                      String                @id @default(uuid())
  publicReference         String                @unique // e.g. "HT-CON-89421A"
  idempotencyKey          String?               @unique
  userId                  String?
  user                    User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  consultantId            String?
  consultant              Consultant?           @relation(fields: [consultantId], references: [id], onDelete: SetNull)
  consultantNameSnapshot  String?
  consultantTitleSnapshot String?
  homeownerName           String
  homeownerPhone          String
  homeownerEmail          String
  projectId               String?
  project                 Project?              @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectSnapshot         Json?
  projectLocation         String
  projectType             String
  consultationTopic       String
  message                 String?
  preferredDate           String
  preferredTime           String
  confirmedDateTime       DateTime?
  status                  ConsultationStatus    @default(AWAITING_REVIEW)
  amountMinorUnits        Int                   @default(149900) // ₹1,499 in paise
  currency                String                @default("INR")
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  payments                ConsultationPayment[]
  events                  ConsultationEvent[]

  @@index([userId])
  @@index([consultantId])
  @@index([status])
  @@index([publicReference])
  @@index([idempotencyKey])
  @@index([createdAt])
  @@map("consultation_requests")
}

model ConsultationPayment {
  id                    String              @id @default(uuid())
  consultationRequestId String
  consultationRequest   ConsultationRequest @relation(fields: [consultationRequestId], references: [id], onDelete: Cascade)
  gateway               String              @default("RAZORPAY")
  gatewayOrderId        String              @unique
  gatewayPaymentId      String?             @unique
  gatewaySignature      String?
  amountMinorUnits      Int                 @default(149900)
  currency              String              @default("INR")
  status                PaymentStatus       @default(PENDING)
  verifiedAt            DateTime?
  rawResponseJson       Json?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([consultationRequestId])
  @@index([gatewayOrderId])
  @@index([status])
  @@map("consultation_payments")
}

model ConsultationEvent {
  id                    String              @id @default(uuid())
  consultationRequestId String
  consultationRequest   ConsultationRequest @relation(fields: [consultationRequestId], references: [id], onDelete: Cascade)
  actorId               String?
  actorRole             String?             // "ADMIN" | "USER" | "SYSTEM"
  eventType             String              // "REQUEST_CREATED" | "PAYMENT_CONFIRMED" | "STATUS_CHANGED" | "CONSULTANT_ASSIGNED" | "SCHEDULE_CONFIRMED" | "INTERNAL_NOTE_ADDED"
  title                 String
  internalNote          String?             // Private to admin
  metadataJson          Json?
  createdAt             DateTime            @default(now())

  @@index([consultationRequestId])
  @@index([createdAt])
  @@map("consultation_events")
}

// ============================================================
// COMMERCIAL PRICING & PRODUCT ENTITLEMENTS (PRICING V1)
// Tier 1: FREE (0 paise)
// Tier 2: ₹99 (9900 paise)
// Tier 3: ₹499 (49900 paise)
// Tier 4: COMPLETE PACKAGE (Not yet finalized, admin configurable)
// Canonical calculator mathematics remain completely decoupled.
// ============================================================

enum PricingPurchaseStatus {
  CREATED
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

model PricingTier {
  id               String            @id @default(uuid())
  code             String            @unique // "FREE" | "ESTIMATE_99" | "DETAILED_ESTIMATE_499" | "COMPLETE_PACKAGE"
  name             String
  description      String
  priceMinorUnits  Int               @default(0) // Integer paise (e.g. 0, 9900, 49900)
  currency         String            @default("INR")
  active           Boolean           @default(true)
  purchasable      Boolean           @default(false)
  sortOrder        Int               @default(0)
  badge            String?
  features         String[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  purchases        PricingPurchase[]
  auditLogs        PricingAuditLog[]

  @@index([code])
  @@index([active])
  @@index([purchasable])
  @@map("pricing_tiers")
}

model PricingPurchase {
  id                 String                @id @default(uuid())
  publicReference    String                @unique // e.g. "HT-PUR-XXXXXX"
  userId             String?
  user               User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  tierId             String
  tier               PricingTier           @relation(fields: [tierId], references: [id])
  tierCodeSnapshot   String
  tierNameSnapshot   String
  amountMinorUnits   Int                   // Preserved historical purchase amount
  currency           String                @default("INR")
  status             PricingPurchaseStatus @default(PENDING)
  gateway            String                @default("RAZORPAY")
  gatewayOrderId     String?               @unique
  gatewayPaymentId   String?               @unique
  leadName           String
  leadPhone          String
  leadEmail          String
  projectId          String?
  project            Project?              @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectSnapshot    Json?
  entitlements       UserEntitlement[]
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@index([userId])
  @@index([tierId])
  @@index([status])
  @@index([publicReference])
  @@index([gatewayOrderId])
  @@index([createdAt])
  @@map("pricing_purchases")
}

model UserEntitlement {
  id               String           @id @default(uuid())
  userId           String?
  user             User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  userEmail        String?
  projectId        String?
  project          Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  featureCode      String
  sourcePurchaseId String?
  sourcePurchase   PricingPurchase? @relation(fields: [sourcePurchaseId], references: [id], onDelete: SetNull)
  active           Boolean          @default(true)
  startsAt         DateTime         @default(now())
  expiresAt        DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([userId])
  @@index([userEmail])
  @@index([projectId])
  @@index([featureCode])
  @@index([active])
  @@map("user_entitlements")
}

model PricingAuditLog {
  id          String       @id @default(uuid())
  tierId      String?
  tier        PricingTier? @relation(fields: [tierId], references: [id], onDelete: SetNull)
  tierCode    String?
  actorEmail  String       @default("admin@hutty.in")
  action      String       // "PRICE_UPDATED" | "STATUS_CHANGED" | "FEATURES_UPDATED" | "TIER_CREATED"
  oldValue    Json?
  newValue    Json?
  reason      String?
  createdAt   DateTime     @default(now())

  @@index([tierId])
  @@index([createdAt])
  @@map("pricing_audit_logs")
}


