# ==============================================================================
# Hutty Cost Calculator — Environment Variables (.env.example)
# ==============================================================================
#
# Client-Side Configuration (Vite)
# Vite exposes variables prefixed with VITE_ to the browser client.
#
# ------------------------------------------------------------------------------
# Developer Full PDF Testing Bypass
# ------------------------------------------------------------------------------
# Set to 'true' in local development (.env.local) to preview or download the
# complete 22-section PDF dossier without completing lead capture or payment.
#
# SECURITY & COMPILATION BARRIER:
# In production builds (`npm run build`), Vite compiles `import.meta.env.DEV` to
# `false`. The application hard-gates this bypass so it is permanently disabled
# and inaccessible in production environments, regardless of environment values.
#
VITE_DEVELOPMENT_FULL_PDF_TESTING=false
